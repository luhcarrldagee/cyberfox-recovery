				</listitem>
				<listitem name="Restore stock recovery">
					<icon res="bs_btn_set_ota"/>
					<action function="queueclear"/>
					<action function="set">fox_m_author=CyberFox Lab</action>
					<action function="set">fox_m_name=Restore stock recovery</action>
					<action function="set">tw_file=CFX-Restore-Stock-Recovery.zip</action>
					<action function="set">tw_filename=/FFiles/CyberFox/CFX-Restore-Stock-Recovery.zip</action>
					<action function="set">tw_filecheck=%tw_filename%</action>
					<action function="set">install_back=cyberfox</action>
					<action function="set">tw_zip_location=/FFiles/CyberFox</action>
					<action function="queuezip"/>
					<action function="set">tw_notexistpage=fox_modules_confirm</action>
					<action function="set">tw_existpage=fox_modules_confirm</action>
					<action function="page">filecheck</action>
				</listitem>
				<listitem name="Device report">
					<icon res="bs_btn_set_about"/>
					<action function="queueclear"/>
					<action function="set">fox_m_author=CyberFox Lab</action>
					<action function="set">fox_m_name=Device report</action>
					<action function="set">tw_file=CFX-Device-Report.zip</action>
					<action function="set">tw_filename=/FFiles/CyberFox/CFX-Device-Report.zip</action>
					<action function="set">tw_filecheck=%tw_filename%</action>
