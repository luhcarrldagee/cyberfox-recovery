			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>CyberFox Lab</text>
			</text>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">settings</action>
			</action>
		</page>

		<page name="cyberfox_ui">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Interface</text>
			</text>

			<listbox style="settingslist">
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%cfx_ui_list_h%"/>
				<listitem name="Circuit header backdrop">
					<data variable="cfx_hud"/>
				</listitem>
				<listitem name="Electric glow line">
					<data variable="cfx_glow"/>
				</listitem>
			</listbox>

			<text style="caption_hl">
				<placement x="%col1_x_caption%" y="%cfx_ui_cap2_y%"/>
				<text>Quick reboot</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%cfx_ui_list2_y%" w="%screen_w%" h="%cfx_ui_list2_h%"/>
				<iconsize w="216" h="168" padding="24"/>
				<listitem name="System">
					<icon res="bs_btn_set_global"/>
					<action function="reboot">system</action>
				</listitem>
				<listitem name="Bootloader (fastboot)">
					<icon res="bs_btn_set_ota"/>
					<action function="reboot">bootloader</action>
				</listitem>
				<listitem name="Recovery">
					<icon res="cfx_icon"/>
					<action function="reboot">recovery</action>
				</listitem>
				<listitem name="Power off">
					<icon res="bs_btn_set_screen"/>
					<action function="reboot">poweroff</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">cyberfox</action>
			</action>
		</page>

		<page name="cyberfox_about">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>About</text>
			</text>

			<image>
				<placement x="%center_x%" y="%cfx_about_glow_y%" placement="5"/>
				<image resource="cfx_logo_glow"/>
			</image>
			<image>
				<placement x="%center_x%" y="%cfx_about_logo_y%" placement="4"/>
				<image resource="cfx_logo"/>
			</image>
			<text style="cfx_brand">
				<placement x="%center_x%" y="%cfx_about_t1_y%" placement="5"/>
				<text>CYBERFOX</text>
			</text>
			<text style="cfx_small">
				<placement x="%center_x%" y="%cfx_about_t2_y%" placement="5"/>
				<text>Recovery v%cfx_version% for Pixel 6a (bluejay)</text>
			</text>
			<text style="cfx_body">
				<placement x="%center_x%" y="%cfx_about_t3_y%" placement="5"/>
				<text>Built on OrangeFox Recovery</text>
			</text>
			<text style="cfx_small">
				<placement x="%center_x%" y="%cfx_about_t4_y%" placement="5"/>
				<text>Pixel AIO device tree by leegarchat</text>
			</text>
			<text style="cfx_small">
				<placement x="%center_x%" y="%cfx_about_t5_y%" placement="5"/>
				<text>TWRP / TeamWin - GPL-3.0</text>
			</text>
			<text style="cfx_small">
				<placement x="%center_x%" y="%cfx_about_t6_y%" placement="5"/>
				<text>Lab tools: /FFiles/CyberFox</text>
			</text>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">cyberfox</action>
			</action>
		</page>
	</pages>
</recovery>
