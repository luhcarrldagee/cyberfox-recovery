<?xml version="1.0"?>
<!-- CyberFox additions. Generated by tools/gen_lab_page.py - edit zips/tools.json instead. -->
<recovery>
	<resources>
		<image name="cfx_header" filename="Cyber/header_bg" retainaspect="1"/>
		<image name="cfx_glow_line" filename="Cyber/glow_line" retainaspect="1"/>
		<image name="cfx_logo_glow" filename="Cyber/logo_glow" retainaspect="1"/>
		<image name="cfx_circuit" filename="Cyber/circuit_bg" retainaspect="1"/>
		<image name="cfx_icon" filename="Cyber/cfx_icon" retainaspect="1"/>
		<image name="cfx_logo" filename="SVG/Logos/logo_cfx.svg" retainaspect="1" scale="1.6"/>
		<font name="cfx_brand" filename="Rajdhani-Bold.ttf" size="96"/>
		<font name="cfx_body" filename="Rajdhani-Medium.ttf" size="44"/>
		<font name="cfx_small" filename="Rajdhani-Medium.ttf" size="36"/>
	</resources>

	<variables>
		<variable name="cfx_version" value="1.0"/>
		<variable name="cfx_hud" value="1" persist="1"/>
		<variable name="cfx_glow" value="1" persist="1"/>
		<variable name="cfx_hdr_y" value="%ab_h%-240"/>
		<variable name="cfx_glow_y" value="%ab_h%-18"/>
		<variable name="cfx_ui_list_h" value="420"/>
		<variable name="cfx_ui_cap2_y" value="%ab_h%+500"/>
		<variable name="cfx_ui_list2_y" value="%ab_h%+580"/>
		<variable name="cfx_ui_list2_h" value="%bl_fullscreen_h%-580"/>
		<variable name="cfx_about_glow_y" value="%ab_h%+40"/>
		<variable name="cfx_about_logo_y" value="%ab_h%+360"/>
		<variable name="cfx_about_t1_y" value="%ab_h%+700"/>
		<variable name="cfx_about_t2_y" value="%ab_h%+820"/>
		<variable name="cfx_about_t3_y" value="%ab_h%+960"/>
		<variable name="cfx_about_t4_y" value="%ab_h%+1030"/>
		<variable name="cfx_about_t5_y" value="%ab_h%+1100"/>
		<variable name="cfx_about_t6_y" value="%ab_h%+1170"/>
	</variables>

	<styles>
		<style name="cfx_brand">
			<font resource="cfx_brand" color="%accent%"/>
		</style>
		<style name="cfx_body">
			<font resource="cfx_body" color="%text%"/>
		</style>
		<style name="cfx_small">
			<font resource="cfx_small" color="%text_secondary%"/>
		</style>
	</styles>

	<pages>
		<!-- CyberFox Lab: every tool is a flashable zip in /FFiles/CyberFox -->
		<page name="cyberfox">
			<listbox style="group_list">
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%bl_fullscreen_h%"/>
				<iconsize w="216" h="168" padding="24"/>
				<listitem name="Backup critical partitions">
					<icon res="bs_btn_restore"/>
					<action function="queueclear"/>
					<action function="set">fox_m_author=CyberFox Lab</action>
					<action function="set">fox_m_name=Backup critical partitions</action>
					<action function="set">tw_file=CFX-Backup-Critical.zip</action>
					<action function="set">tw_filename=/FFiles/CyberFox/CFX-Backup-Critical.zip</action>
					<action function="set">tw_filecheck=%tw_filename%</action>
					<action function="set">install_back=cyberfox</action>
					<action function="set">tw_zip_location=/FFiles/CyberFox</action>
					<action function="queuezip"/>
					<action function="set">tw_notexistpage=fox_modules_confirm</action>
					<action function="set">tw_existpage=fox_modules_confirm</action>
					<action function="page">filecheck</action>
				</listitem>
				<listitem name="Restore critical partitions">
					<icon res="bs_btn_restore"/>
					<action function="queueclear"/>
					<action function="set">fox_m_author=CyberFox Lab</action>
					<action function="set">fox_m_name=Restore critical partitions</action>
					<action function="set">tw_file=CFX-Restore-Critical.zip</action>
